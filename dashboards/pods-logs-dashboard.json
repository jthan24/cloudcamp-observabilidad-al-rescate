    {
      "type": "logs",
      "title": "Recent Logs (Loki)",
      "targets": [
        {
          "expr": "{namespace=\"observabilidad\"} |= \"error\""
        }
      ]
    }
  ],
  "title": "Pods & Logs (Demo)"
}